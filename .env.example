# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO PARA ENTORNO DE PRODUCCIÓN / DESARROLLO
# Proyecto: Apoyo Escolar Crecer - Backend API (Rails 8 & Ruby 3.3.3)
# ==============================================================================

# --- ENTORNO Y SERVIDOR ---
RAILS_ENV=production
PORT=3000
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# --- SEGURIDAD Y JWT ---
# Generar una clave segura con `rails secret`
SECRET_KEY_BASE=tu_clave_secreta_super_robusta_generada_con_rails_secret

# --- BASE DE DATOS POSTGRESQL ---
# Formato completo de conexión PostgreSQL o variables individuales
DATABASE_URL=postgres://usuario:password@localhost:5432/crecer_academic_support_production
# POSTGRES_USER=usuario
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=crecer_academic_support_production

# --- CORS Y DOMINIOS DE CLIENTES ---
# URLs permitidas para consumir la API (separadas por comas si son múltiples)
FRONTEND_URL=https://apoyoescolarcrecer.com
ALLOWED_ORIGINS=https://apoyoescolarcrecer.com,https://admin.apoyoescolarcrecer.com
MOVIL_URL=https://app.apoyoescolarcrecer.com

# --- ACTION MAILER (ENVÍO ASÍNCRONO CON SOLID QUEUE) ---
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_tu_api_key_aqui
SMTP_DOMAIN=apoyoescolarcrecer.com
MAILER_SENDER=notificaciones@apoyoescolarcrecer.com

# --- INTEGRACIÓN WHATSAPP CLOUD API (META GRAPH API) ---
WHATSAPP_ACCESS_TOKEN=tu_whatsapp_access_token_permanente
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=token_seguro_handshake_meta_webhook
WHATSAPP_APP_SECRET=tu_app_secret_de_meta_para_verificar_hmac_sha256

# --- ACTIVE STORAGE (ALMACENAMIENTO DE ARCHIVOS Y AVATARES) ---
# Opciones disponibles: local, amazon, etc. (ver config/storage.yml)
STORAGE_SERVICE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=crecer-academic-assets

